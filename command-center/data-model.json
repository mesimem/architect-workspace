{
  "schema_version": 1,
  "derived_from": "backend/src/services/**: every createJsonFileStore(\"<name>\") call outside tests, read on 2026-10-05",
  "storage": "Each entity is a durable keyed JSON store (backend/src/services/shared/jsonFileStore.js), persisted under COLABERRY_DATA_DIR when set and in-memory otherwise. The interface is Map-shaped so a later move to Postgres touches that one file. These are not SQL tables yet.",
  "caveats": [
    "No store holds a customer entity, so customerId references nothing in this model.",
    "Inner shapes of contracts, rates, itinerary and pricing were not traced; only top-level fields are listed.",
    "advisor-reviews and africa-interactions rows are spread from caller objects; their fields come from the call sites.",
    "Relationships are by value; nothing enforces them."
  ],
  "entities": [
    {"store": "crm-transactions", "entity": "Booking transaction", "source": "backend/src/services/booking/crmTransactionLog.js", "key": "tripId", "fields": ["tripId", "customerId", "status", "legs", "amountCents", "currency", "bookedAt", "groupId"], "relationships": [{"field": "groupId", "references": "group-bookings"}], "stories": ["STORY-001", "STORY-003"], "notes": "One row per trip; group bookings add one row per member carrying groupId."},
    {"store": "booking-statuses", "entity": "Booking status overlay", "source": "backend/src/services/booking/bookingStatusStore.js", "key": "tripId", "fields": ["tripId", "status", "previousStatus", "version", "firstChangedAt", "changedAt", "changedBy"], "relationships": [{"field": "tripId", "references": "crm-transactions"}], "stories": ["STORY-018"], "notes": "Overlay on crm-transactions, no money stored. No row means untouched (confirmed)."},
    {"store": "group-bookings", "entity": "Group booking", "source": "backend/src/services/booking/groupBookingService.js", "key": "idempotencyKey", "fields": ["groupId", "groupName", "organizerId", "status", "itinerary", "members", "perPersonCents", "totalCents", "currency", "bookedAt", "fingerprint"], "relationships": [{"field": "members[].tripId", "references": "crm-transactions"}], "stories": ["STORY-008"], "notes": "members entries are {memberId, fullName, tripId}."},
    {"store": "payment-accounts", "entity": "Payment account", "source": "backend/src/services/payments/paymentAccountStore.js", "key": "accountId", "fields": ["accountId", "customerId", "tripRef", "currency", "totalCents", "openedBy", "openedAt", "payments"], "relationships": [], "stories": ["STORY-011"], "notes": "payments entries are {paymentId, amountCents, status, reason, processedAt}. Balance is derived on read, never stored."},
    {"store": "accounting-posted", "entity": "Accounting posting receipt", "source": "backend/src/services/accounting/accountingClient.js", "key": "transactionId", "fields": ["reference", "unverified", "postedAt"], "relationships": [{"field": "transactionId", "references": "crm-transactions"}, {"field": "transactionId", "references": "group-bookings"}], "stories": ["STORY-004"], "notes": "Dedup receipt so a transaction is posted to accounting once."},
    {"store": "audit-log", "entity": "Audit entry", "source": "backend/src/services/audit/auditLog.js", "key": "auditKey", "fields": ["auditKey", "recordedAt", "event", "outcome", "actor", "resource", "correlationId", "context"], "relationships": [], "stories": ["STORY-004", "STORY-006"], "notes": "Append-only, first write wins. resource holds ids from many stores."},
    {"store": "advisor-reviews", "entity": "Advisor review flag", "source": "backend/src/services/advisor/advisorReviewQueue.js", "key": "requestId", "fields": ["requestId", "status", "customerId", "reasons", "source", "context", "flaggedAt", "notificationStatus", "notificationDetail", "notificationUpdatedAt"], "relationships": [], "stories": ["STORY-003"], "notes": "status defaults to pending_review."},
    {"store": "africa-interactions", "entity": "African section interaction", "source": "backend/src/services/africa/interactionLog.js", "key": "interactionKey", "fields": ["interactionKey", "customerId", "destinationId", "action", "outcome", "destinationCount"], "relationships": [], "stories": ["STORY-002", "STORY-003"], "notes": "destinationId, action and destinationCount are not always present."},
    {"store": "crm-leads", "entity": "Lead", "source": "backend/src/services/crm/leadStore.js", "key": "leadId", "fields": ["leadId", "fullName", "email", "source", "status", "notes", "createdAt", "updatedAt", "createdBy"], "relationships": [], "stories": ["STORY-014", "STORY-016"], "notes": "Dedup on normalised email and source. Not linked to customers or bookings."},
    {"store": "role-assignments", "entity": "Role assignment", "source": "backend/src/services/authz/roleAssignments.js", "key": "userId", "fields": ["userId", "role", "previousRole", "assignedBy", "assignedAt", "reason", "correlationId"], "relationships": [], "stories": ["STORY-006"], "notes": "Current role per user; overrides the token directory role."},
    {"store": "portal-sessions", "entity": "Portal session", "source": "backend/src/services/portal/portalSessions.js", "key": "sessionId (SHA-256 of the token)", "fields": ["sessionId", "customerId", "role", "createdAt", "lastSeenAt", "idleExpiresAt", "absoluteExpiresAt"], "relationships": [], "stories": ["STORY-005", "STORY-006"], "notes": "The token itself is never stored. At most 10 sessions per customer."},
    {"store": "quotes", "entity": "Quote", "source": "backend/src/services/quotes/quoteStore.js", "key": "quoteId", "fields": ["quoteId", "customerId", "tripReference", "title", "status", "version", "createdAt", "updatedAt", "issuedBy", "lastModifiedBy", "customerNote", "internalNotes", "pricing", "createdWith", "lastModifiedWith"], "relationships": [], "stories": ["STORY-007"], "notes": "internalNotes and internal pricing never reach the customer's copy."},
    {"store": "proposals", "entity": "Trip proposal", "source": "backend/src/services/proposals/proposalStore.js", "key": "proposalId", "fields": ["proposalId", "customerId", "tripReference", "title", "status", "version", "startedAt", "updatedAt", "completedAt", "openedBy", "completedBy", "customerNote", "internalNotes", "pricing", "sla", "createdWith", "lastModifiedWith"], "relationships": [], "stories": ["STORY-013"], "notes": "startedAt is the 30-minute SLA clock, written once."},
    {"store": "safari-products", "entity": "Safari product", "source": "backend/src/services/products/safariProductStore.js", "key": "productId", "fields": ["productId", "name", "country", "summary", "durationDays", "itinerary", "pricing", "version", "createdAt", "updatedAt", "createdBy", "updatedBy"], "relationships": [], "stories": ["STORY-015"], "notes": "Dedup on name and country. Not yet linked to suppliers."},
    {"store": "travel-packages", "entity": "Travel package", "source": "backend/src/services/packages/packageStore.js", "key": "packageId", "fields": ["packageId", "name", "summary", "components", "discountBasisPoints", "pricing", "version", "createdAt", "updatedAt", "createdBy", "updatedBy"], "relationships": [{"field": "components[].productId", "references": "safari-products"}], "stories": ["STORY-017"], "notes": "components entries are {kind, productId, startDay}; pricing is a snapshot at last save."},
    {"store": "suppliers", "entity": "Supplier", "source": "backend/src/services/suppliers/supplierStore.js", "key": "supplierId", "fields": ["supplierId", "name", "country", "supplierType", "contactEmail", "contactPhone", "notes", "contracts", "rates", "version", "createdAt", "updatedAt", "createdBy", "updatedBy"], "relationships": [], "stories": ["STORY-010"], "notes": "Dedup on name and country. Nothing references supplierId yet."}
  ]
}
